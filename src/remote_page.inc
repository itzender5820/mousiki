  items.push({ t: C.text + "Open the manual", cmd: "@manual" });
  items.push("", { t: center(C.border + "[ CLOSE ]", 36), cmd: "@close" }, "");
  overlay = panel("REMOTE SETTINGS", items, 40);
  overlay.menu = true;
  draw();
}

function showLost(text) {
  if (overlay && !overlay.lost) return;
  overlay = panel("NO CONNECTION", [
    "",
    C.text + text,
    C.legend + "Is Mousiki running, with Remote App on,",
    C.legend + "and the phone in the same network?",
    "",
    { t: center(C.border + "[ RETRY ]", 36), cmd: "@retry" },
    APP ? { t: center(C.border + "[ OTHER COMPUTER ]", 36), cmd: "@connect" } : "",
    "",
  ], 40);
  overlay.lost = true;
  draw();
}

// ---- talking to Mousiki ----------------------------------------------------------------------------------------------
let rev = -1, busy = false, failures = 0, timer = 0;
async function poll() {
  clearTimeout(timer);
  if (busy) return;
  if (!pin) { if (!overlay) showPin(""); timer = setTimeout(poll, 500); return; }
  busy = true;
  try {
    const r = await fetch("/api/screen?pin=" + encodeURIComponent(pin) + "&cols=" + cols + "&rows=" + rows, { cache: "no-store" });
    if (r.status === 403) { pin = ""; store.set("pin", ""); showPin("wrong PIN"); }
    else if (r.status === 429) { showLost("too many wrong PINs: wait a minute"); }
    else if (r.ok) {
      const s = await r.json();
      failures = 0;
      if (overlay && overlay.lost) overlay = null;
      if (s.rev !== rev) {
        rev = s.rev;
        screen = s;
        const n = parseInt(s.text, 10);
        textColor = n >= 1 && n <= 255 ? PAL[n] : "";
        grid = s.lines.map(parseLine);
        if (s.image) {   // fetched once per picture
          if (!picture || picture.key !== s.image.key) {
            const p = { key: s.image.key, img: new Image(), ready: false };
            p.img.onload = () => { p.ready = true; if (picture === p) shown = p; draw(); };
            p.img.onerror = () => { if (picture === p) picture = null; };   // (asked again with the next screen)
            p.img.src = "/api/image?pin=" + encodeURIComponent(pin) + "&key=" + encodeURIComponent(s.image.key);
            picture = p;
          }
        } else { picture = null; shown = null; }
        draw();
      }
    }
  } catch (e) {
    if (++failures >= 3) showLost("Mousiki does not answer.");
  }
  busy = false;
  timer = setTimeout(poll, document.hidden ? 2000 : (failures ? 1000 : (screen && screen.image ? 35 : 80)));   // (a turning cover: a new picture every few hundredths of a second)
}

async function send(cmd, arg) {
  try {
    await fetch("/api/cmd?pin=" + encodeURIComponent(pin) + "&name=" + encodeURIComponent(cmd) + "&arg=" + encodeURIComponent(arg || ""), { cache: "no-store" });
  } catch (e) {}
  setTimeout(poll, 30);
}

function openManual() {
  if (APP && APP.openUrl) APP.openUrl(MANUAL_URL);
  else window.open(MANUAL_URL, "_blank");
}

function act(cmd, arg) {
  switch (cmd) {
    case "@manual": openManual(); return;
    case "@menu": showMenu(); return;
    case "@close": overlay = null; draw(); return;
    case "@palette": {
      const k = Object.keys(BASE16); paletteName = k[(k.indexOf(paletteName) + 1) % k.length];
      store.set("palette", paletteName); buildPalette();
      if (screen) grid = screen.lines.map(parseLine);
      showMenu(); return;
    }
    case "@dots": {
      const k = ["thick", "normal", "small"]; dotSize = k[(k.indexOf(dotSize) + 1) % k.length];
      store.set("dots", dotSize); showMenu(); return;
    }
    case "@pin": showPin(""); return;
    case "@type": typed.focus(); return;
    case "@pin-ok":
      if (pinDraft.length >= 4) { pin = pinDraft; store.set("pin", pin); overlay = null; typed.blur(); rev = -1; poll(); }
      return;
    case "@retry": overlay = null; failures = 0; draw(); poll(); return;
    case "@connect": if (APP && APP.connectScreen) APP.connectScreen(); return;
  }
  send(cmd, arg);
}

// ---- taps --------------------------------------------------------------------------------------------------------------
function zoneAt(px, py) {
  const c = Math.floor((px * dpr - ox) / cw), r = Math.floor((py * dpr - oy) / ch);
  const list = overlay ? overlay.zones : (screen ? screen.zones : []);
  for (let i = list.length - 1; i >= 0; i--) {
    const z = list[i];
    if (c >= z.x && c < z.x + z.w && r >= z.y && r < z.y + z.h) return z;
  }
  return null;
}
